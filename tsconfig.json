{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "lib": ["ES2024"],
    "types": ["node"]
  },
  "include": ["*.js", "bin/**/*.js", "eval/**/*.js", "scripts/**/*.js", "src/**/*.js"],
  "exclude": ["node_modules", "vendor", "dashboard", "test", ".factory"]
}
