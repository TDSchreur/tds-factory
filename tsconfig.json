{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "*.js",
    "bin/**/*.js",
    "dashboard/*.js",
    "eval/**/*.js",
    "scripts/**/*.js",
    "src/**/*.js",
    "test/**/*.js"
  ],
  "exclude": ["node_modules", "vendor", "dashboard/vendor", ".factory"]
}
