{
  "name": "tds-factory",
  "version": "0.5.0",
  "description": "A simple software factory: curated agent skills installed into Claude, Codex and Copilot.",
  "type": "module",
  "bin": {
    "tds-factory": "bin/tds-factory.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "agents",
    "dashboard",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "test": "node scripts/with-temp-dir.js node --test test/*.test.js",
    "test:unit": "node scripts/with-temp-dir.js node scripts/test-unit.js",
    "test:browser": "node scripts/with-temp-dir.js node --test test/*-browser.test.js",
    "test:package": "node scripts/with-temp-dir.js node scripts/test-package.js",
    "eval": "node scripts/with-temp-dir.js node eval/run.js"
  },
  "engines": {
    "node": ">=20"
